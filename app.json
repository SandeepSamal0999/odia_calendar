{
  "expo": {
    "name": "Odia Calendar 2026",
    "slug": "odia-calendar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.samallabs.odiacalendar",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E20E4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ],
    "scheme": "odiacalendar",
    "experiments": {
      "typedRoutes": true
    }
  }
}
